# Yugioh Classic Remaster. Lista blanca: todo queda fuera salvo lo que se nombra abajo.
# NUNCA subir: nada de Konami (juego, Data.dat, imagenes, mazos extraidos, modelos o arte derivados de las
# cartas), claves (herramientas/claves), perfiles del navegador, la IP de la consola (remake-ps5/consola_ip.txt).
/*
!/.gitignore
!/README.md
!/README.en.md
!/.gitattributes
!/docs/

# remake PS5 (codigo propio)
!/remake-ps5/
/remake-ps5/*
!/remake-ps5/src/
!/remake-ps5/shaders/
!/remake-ps5/pc/
!/remake-ps5/third_party/
!/remake-ps5/escena/
/remake-ps5/escena/*
!/remake-ps5/escena/escena.h
!/remake-ps5/*.py
!/remake-ps5/*.sh
!/remake-ps5/docs/
!/remake-ps5/servidor/
!/remake-ps5/escenarios/
/remake-ps5/escenarios/__pycache__/
/remake-ps5/consola_ip.txt
!/remake-ps5/yugictl/
/remake-ps5/yugictl/*
!/remake-ps5/yugictl/*.py

# diseno del remake (tablero, tamanos, plantillas, reglas de combate)
!/remake/
/remake/*
!/remake/diseno/

# herramientas propias (solo scripts)
!/herramientas/
/herramientas/*
!/herramientas/*.py
!/herramientas/blender/
!/herramientas/colab_trellis/
!/herramientas/esqueletos/
/herramientas/esqueletos/__pycache__/
!/herramientas/unreal/
!/herramientas/audio/
!/herramientas/fx_md/
!/herramientas/md_fases/
!/herramientas/md_ritmo/
!/herramientas/puente-gemini/
/herramientas/puente-gemini/*
!/herramientas/puente-gemini/*.py

__pycache__/
*.pyc

# Listas de cartas con imagenes de Konami (no subir)
listas/

# instalador: la salida (.exe/.bin con arte de Konami) nunca al repo
/remake-ps5/pc/instalador/*.bin
/remake-ps5/pc/instalador/Output/
/remake-ps5/pc/instalador/YugiohClassic_Instalador*
